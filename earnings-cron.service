[Unit]
Description=Earnings Table Cron Jobs
After=network.target

[Service]
Type=simple
# Run as a dedicated non-root user (create it: `useradd -r -s /bin/false earnings`).
User=earnings
Group=earnings
WorkingDirectory=/srv/EarningsTable/modules/cron
# Secrets are loaded from an env file (chmod 600, owned by root:earnings).
# Format: KEY=value (one per line). Do NOT commit this file.
EnvironmentFile=/etc/earnings-table/env
Environment="NODE_ENV=production"
Environment="CRON_TZ=America/New_York"
Environment="DATABASE_URL=file:/srv/EarningsTable/modules/database/prisma/prod.db"
# Use the tsx executable directly (it is a shell-script wrapper with a shebang).
# Do NOT prefix with `node` — `node node_modules/.bin/tsx` fails because the
# bin is a shell script, not a JS file.
ExecStart=/srv/EarningsTable/modules/cron/node_modules/.bin/tsx src/main.ts start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
