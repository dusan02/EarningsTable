# API Keys (required by the pipeline)
FINNHUB_TOKEN=your_finnhub_token_here
POLYGON_API_KEY=your_polygon_api_key_here

# Database
DATABASE_URL="file:D:/Projects/EarningsTable/modules/database/prisma/dev.db"

# Server
PORT=3001
# Optional: override the base URL used by synthetic tests (defaults to http://localhost:$PORT)
# BASE_URL=http://localhost:3001

# Environment
NODE_ENV=development

# Cron Configuration
CRON_TZ=America/New_York

# Batch Configuration
SNAPSHOT_BATCH_SIZE=75
SNAPSHOT_BATCH_DELAY_MS=50
LOGO_BATCH_SIZE=12
LOGO_CONCURRENCY=6
LOGO_BATCH_DELAY_MS=150
SNAPSHOT_TICKER_CONCURRENCY=12

# Optional: override logo output directory (defaults to modules/web/public/logos)
# LOGO_DIR=/srv/EarningsTable/modules/web/public/logos

# -----------------------------------------------------------------------------
# Production (systemd): copy this file to /etc/earnings-table/env (chmod 600,
# owned by root:earnings) and fill in real values. Both earnings-cron.service
# and earnings-table.service load it via EnvironmentFile.
# -----------------------------------------------------------------------------